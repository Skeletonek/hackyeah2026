{
  "name": "splot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --linked --schema public > lib/supabase/database.types.ts",
    "auth:push": "supabase config push",
    "data:scrape": "tsx scripts/scrape-library.ts",
    "data:enrich": "tsx --conditions=react-server --env-file=.env.local scripts/enrich-library.ts",
    "data:import": "tsx --conditions=react-server --env-file=.env.local scripts/import-library.ts",
    "data:indicators": "tsx scripts/scrape-indicators.ts",
    "data:counties": "tsx scripts/build-county-shapes.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.130",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "ai": "^7.0.127",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.3"
}
