# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only (lib/supabase/admin.ts). Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Vercel AI Gateway — local dev only (shared key from the team vault). On Vercel, OIDC is used instead.
AI_GATEWAY_API_KEY=vck_...

# Absolute links in notification e-mails. In Docker it is a build arg (NEXT_PUBLIC_ is inlined at build time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: notification e-mails via Resend. Without the key only the in-app bell works.
# Without a verified domain Resend delivers only to the Resend account owner's address.
RESEND_API_KEY=
RESEND_FROM=Splot <onboarding@resend.dev>
